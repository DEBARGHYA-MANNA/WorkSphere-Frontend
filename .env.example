# ---------------------------------------------------------------------------
# WorkSphere Frontend — environment configuration
# Copy to `.env` (or `.env.local`) and adjust. Never commit real secrets.
# Only variables prefixed with VITE_ are exposed to browser code, and anything
# exposed there is public — never put secrets in a VITE_* variable.
# ---------------------------------------------------------------------------

# Path the browser calls for API requests. Leave as `/api/v1` so requests are
# same-origin (Vite proxies them in dev, the reverse proxy does it in prod).
# This keeps the HttpOnly refresh cookie first-party and avoids CORS.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev/preview server proxies `/api`. Used by the dev server only,
# never shipped to the browser.
VITE_API_PROXY_TARGET=http://localhost:3000

# Human-readable name used in the document title / shell.
VITE_APP_NAME=WorkSphere

# Request timeout in milliseconds for the Axios client.
VITE_API_TIMEOUT=20000
